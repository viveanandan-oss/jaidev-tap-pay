
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jaidev-tap-pay",
  "compatibility_date": "2026-11-16",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
